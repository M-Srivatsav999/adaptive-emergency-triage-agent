# Copy to .env and edit. Real environment variables override these.

# --- LLM / embeddings (local Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=45

# --- PostgreSQL + pgvector (optional; leave empty to use SQLite + in-memory retrieval) ---
# DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
POSTGRES_PASSWORD=triage
AUTO_INGEST=true
RETRIEVER=auto            # auto | tfidf | pgvector

# --- Server ---
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=*
TRIAGE_DB_PATH=./data/triage.db
SESSION_TTL_SECONDS=3600
RAG_CANDIDATE_COUNT=6

# --- Locale (shown on every result and PDF) ---
EMERGENCY_CONTACTS=Emergency: 112 (India) / ambulance 108 in many states; mental-health helpline Tele-MANAS 14416

# --- Production hardening (see docs/SECURITY.md, docs/OPERATIONS.md) ---
ENV=development                 # set to production for a real deployment (enables strict checks)
AUTH_MODE=open                  # open = everyone can use it, a free account adds a private history; off = local demo only
SECRET_KEY=                     # REQUIRED in production: python -c "import secrets;print(secrets.token_hex(32))"
TOKEN_TTL_SECONDS=28800
RETENTION_DAYS=90               # stored sessions older than this are deleted automatically (0 = keep forever)
STORE_SESSIONS=true             # false = save nothing
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES=5
MAX_INPUT_CHARS=2000
TRUST_PROXY=false               # true only behind your own HTTPS proxy (Caddy profile)
SITE_ADDRESS=localhost          # hostname for the HTTPS profile
BACKUP_DIR=./backups

# --- Open access ---
REGISTRATION_OPEN=true          # anyone may create a free account (private history). false = closed
MIN_USER_PASSWORD_LEN=8
REGISTER_LIMIT_PER_HOUR=20      # per address
